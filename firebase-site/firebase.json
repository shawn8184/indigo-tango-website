{
  "hosting": {
    "site": "indigo-tango-website",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/pricing",
        "destination": "/engagements",
        "type": 301
      },
      {
        "source": "/pricing/",
        "destination": "/engagements",
        "type": 301
      }
    ]
  }
}
